set cut_paste_input [stack 0]
version 12.0 v8
push $cut_paste_input
Group {
 name ComfyUIGizmo
 tile_color 0xa2b275ff
 selected true
 xpos 28
 ypos -48
 addUserKnob {20 controls l Controls}
 addUserKnob {26 comfyui_gizmo l ComfyUIGizmo +INVISIBLE T "This knob only allows the read and backup to be outside the gizmo !"}
 addUserKnob {41 run l Run T Run.run}
 addUserKnob {22 inferenceStart +HIDDEN T "" +STARTLINE}
 addUserKnob {22 inferenceEnd +HIDDEN T "# Available variables: read, iter, node_iter" +STARTLINE}
}
 Input {
  inputs 0
  name Input
  xpos -40
  ypos -417
 }
 Group {
  name Write
  tile_color 0xbcb50001
  xpos -40
  ypos -393
  addUserKnob {20 Controls}
  addUserKnob {2 filepath_ l filepath}
  addUserKnob {4 format_ l format M {png exr}}
  format_ exr
  addUserKnob {4 bit_depth_ l bit_depth M {8bit 16bit 32bit}}
  bit_depth_ 16bit
  addUserKnob {4 compression_ l compression M {none "Zip (1 scanline)" "Zip (16 scanlines)" "PIZ Wavelet (32 scanlines)" RLE B44 B44A}}
  compression_ "Zip (16 scanlines)"
  addUserKnob {4 color_space_ l color_space M {sRGB linear}}
  color_space_ linear
  filepath_ image_####.exr
  addUserKnob {22 data -STARTLINE +HIDDEN T "LRx4!F+o`-Q&|Ch@jCzjf*XJk1ON~KiofsPDlh=Jf>dQRXn8<r2893vKmY<\$L\{Cr?Mw&B3Tp4hO;s\{*3&0-XW9lMt&AWTQBe<qy=Ng!&lnu\{)XY0iwiF03DKEJX\}@K5q>Vj#o*\}\$9Bx2Lj8T\{+UgoNl7T915N333gN0mzyI0\{6p)n<-nL(&ljJg9NoLN;%BMGL\$JYP~zg6GK<Q9|k@Crd\{N!R_v>\{\{AlHig2MI0\{h~2"}
 }
  Input {
   inputs 0
   name images
  }
  Output {
   name Output1
   selected true
  }
 end_group
 Group {
  name Run
  tile_color 0x609e38ff
  note_font "Bitstream Vera Sans"
  xpos -40
  ypos -369
  addUserKnob {20 controls l Controls}
  addUserKnob {22 run l Run t "Send a request to ComfyUI Server" T comfyui.cmd.run() +STARTLINE}
 }
  Input {
   inputs 0
   name Input
   xpos 145
   ypos 93
  }
  Output {
   name Output
   xpos 145
   ypos 257
  }
 end_group
 Output {
  name Output1
  xpos -40
  ypos -343
 }
end_group
