set cut_paste_input [stack 0]
version 12.0 v8
push $cut_paste_input
Group {
 name MetaGizmo
 tile_color 0xa2b275ff
 selected true
 addUserKnob {20 controls l Controls}
 addUserKnob {26 meta_gizmo l MetaGizmo +INVISIBLE T "This knob identifies the MetaGizmo group."}
 addUserKnob {1 gizmo_order l "Gizmo Order" +HIDDEN}
 addUserKnob {22 run l "Run Gizmos" +HIDDEN T "from nukepath.comfyui2nuke.nodes.ComfyUI.MetaGizmo import run_gizmos\nrun_gizmos(nuke.thisNode())"}
 onCreate "from nukepath.comfyui2nuke.nodes.ComfyUI.MetaGizmo import install\ninstall(nuke.thisNode())"
}
 Input {
  inputs 0
  name Input
  xpos 0
  ypos 0
 }
 Output {
  name Output
  xpos 0
  ypos 100
 }
end_group
