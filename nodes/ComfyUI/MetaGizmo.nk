set cut_paste_input [stack 0]
version 12.0 v8
push $cut_paste_input
Group {
 name MetaGizmo
 tile_color 0x786d8fff
 selected true
 addUserKnob {20 controls l Controls}
 addUserKnob {26 comfyui_meta_gizmo +INVISIBLE T MetaGizmo}
 addUserKnob {22 run l Run T "from nukepath.comfyui2nuke.nodes.ComfyUI import MetaGizmo\nMetaGizmo.run()" +STARTLINE}
}
 Input {
  inputs 0
  name Input
  xpos 0
  ypos -200
 }
 NoOp {
  name Output
  tile_color 0x55aa55ff
  label "Connect a ComfyUI gizmo here"
  xpos 0
  ypos 100
  addUserKnob {26 comfyui_meta_output +INVISIBLE T MetaOutput}
  addUserKnob {6 comfyui_meta_enabled l Enabled +STARTLINE}
  comfyui_meta_enabled true
 }
 Output {
  name Output1
  xpos 0
  ypos 160
 }
end_group
