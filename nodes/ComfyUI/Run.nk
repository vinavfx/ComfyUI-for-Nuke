set cut_paste_input [stack 0]
version 12.0 v8
push $cut_paste_input
Group {
 name Run
 tile_color 0x609e38ff
 note_font "Bitstream Vera Sans"
 selected true
 xpos -40
 ypos -369
 addUserKnob {20 controls l Controls}
 addUserKnob {22 run l Run t "Send a request to ComfyUI Server" T comfyui.cmd.run() +STARTLINE}
}
 Input {
  inputs 0
  name Input
  xpos 145
  ypos 93
 }
 Output {
  name Output
  xpos 145
  ypos 257
 }
end_group
